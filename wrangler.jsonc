{
  // Cloudflare Workers: `pnpm build && npx wrangler deploy`.
  // The app is static assets; the Worker script (worker/index.ts) only runs for
  // `/api/*` (sync), so loading the app never counts toward Worker limits.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aletheia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Sync storage. No database_id: `wrangler deploy` creates the database on
  // first deploy. The Worker creates its tables itself.
  "d1_databases": [{ "binding": "DB", "database_name": "aletheia-sync" }],
  // Workers AI: Whisper turns voice memos into text (POST /api/ai/transcribe).
  // Free up to 10,000 neurons a day, about 3.5 hours of audio.
  "ai": { "binding": "AI" },
  // Deploys keep variables added in the Cloudflare dashboard instead of
  // wiping them. Tokens never go in "vars" (this file is public): set
  // CLAUDE_RELAY_TOKEN as a secret (`npx wrangler secret put CLAUDE_RELAY_TOKEN`
  // or the dashboard's Secret type). Deploys never touch secrets.
  // GET /api/feed (pergent) needs the FEED_TOKEN secret and a FEED_PILES variable
  // (a JSON list of piles), both set in the dashboard.
  "keep_vars": true,
  "vars": {
    // Sync spaces this deployment accepts. 1 = the first device to turn sync
    // on owns it; everyone else gets "already has its sync space".
    "SYNC_MAX_SPACES": "1"
  },
  "env": {
    // `npx wrangler dev --env local`: the same without Workers AI, which only runs
    // on Cloudflare and needs a login; voice memos fail there with a clear error.
    "local": {
      "d1_databases": [{ "binding": "DB", "database_name": "aletheia-sync" }],
      "vars": { "SYNC_MAX_SPACES": "1" }
    }
  }
}
