{
  // Cloudflare Workers static-assets deployment: `pnpm build && npx wrangler deploy`.
  // Cloudflare Pages works too: build command `pnpm build`, output directory `dist`
  // (with no 404.html, Pages serves index.html for unknown paths).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aletheia",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
