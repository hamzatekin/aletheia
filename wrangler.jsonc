{
  // Cloudflare Workers static-assets deployment: `pnpm build && npx wrangler deploy`.
  // Cloudflare Pages works too: build command `pnpm build`, output directory `dist`
  // (public/_redirects provides the SPA fallback there).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aletheia",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
